# "mock" uses demo data; blank or "live" uses the real API.
NEXT_PUBLIC_API_MODE=live

# Used by auth/onboarding clients that call the backend directly.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ONBOARDING_STATUS_URL=/api/v1/onboarding/status

# Next.js server-side rewrite target for /api/v1/* requests.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Optional development-only dashboard simulation; set to 1 to enable.
NEXT_PUBLIC_DASH_SIMULATE=0
