# Display name used by the API.
APP_NAME=AI Calling Backend
# Runtime environment; use production only with production secrets configured.
APP_ENV=development
# Enables verbose FastAPI diagnostics when true.
DEBUG=false
# PostgreSQL connection for the application.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_calling

# JWT signing secret; replace this safe development placeholder before production.
JWT_SECRET_KEY=change-this-to-a-random-32-character-development-secret
# JWT signing algorithm.
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh-token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=7
# Fernet key for PIN encryption; required in production.
PIN_ENCRYPTION_KEY=

# Sarvam API key; leave blank when the integration is unused.
SARVAM_API_KEY=
# Sarvam API base URL; leave blank when the integration is unused.
SARVAM_BASE_URL=
# Secret used to verify Sarvam webhook signatures.
SARVAM_WEBHOOK_SECRET=
# Keep enabled only during migration from the shared Sarvam tool token. Set false
# after every client has been moved to an individual tool token.
SARVAM_LEGACY_SHARED_TOKEN_ENABLED=true
# Optional public API origin used to return absolute integration URLs.
PUBLIC_API_BASE_URL=

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000
# Enables API rate limiting when true.
RATE_LIMIT_ENABLED=true
# Default timezone for client operations.
DEFAULT_TIMEZONE=Asia/Kolkata
# Local directory used for uploaded files.
UPLOAD_DIR=uploads
# Enables API documentation in production when true.
DOCS_ENABLED=false

# EMAIL_BACKEND accepts console | resend | smtp; console does not actually send email.
EMAIL_BACKEND=console
# Requires users to verify email before account access when true.
REQUIRE_EMAIL_VERIFICATION=true
# Resend API key; required only by the Resend email backend and the OTP routes.
RESEND_API_KEY=
# Resend sender address; use a sender verified with Resend.
MAIL_FROM=Talkaor <no-reply@example.com>
# Sender address used by the SMTP email backend.
EMAIL_FROM=noreply@example.com
# SMTP server host; required when EMAIL_BACKEND=smtp.
SMTP_HOST=
# SMTP server port.
SMTP_PORT=587
# Optional SMTP authentication username.
SMTP_USER=
# Optional SMTP authentication password.
SMTP_PASSWORD=

# Optional first protected super-admin email; setting any super-admin credential enables startup seeding.
SUPERADMIN_1_EMAIL=
# Optional first protected super-admin password.
SUPERADMIN_1_PASSWORD=
# Optional second protected super-admin email.
SUPERADMIN_2_EMAIL=
# Optional second protected super-admin password.
SUPERADMIN_2_PASSWORD=
# Sync existing super-admin passwords from the environment when true.
SUPERADMIN_SYNC_PASSWORDS=false

# Gunicorn bind port; local uvicorn uses the command-line port instead.
PORT=8000
# Gunicorn worker count; blank uses the Gunicorn default.
WEB_CONCURRENCY=
# Gunicorn worker timeout in seconds.
GUNICORN_TIMEOUT=30

# Test-only PostgreSQL URL; tests read it from the process environment and drop/recreate its schema.
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_calling_test
